-- Pagina inicial
/                               HomeR             GET

-- Artistas: listar, cadastrar, editar e excluir
/artistas                       ArtistasR         GET
/artistas/novo                  ArtistaNovoR      GET POST
/artistas/#ArtistaId/editar     ArtistaEditarR    GET POST
/artistas/#ArtistaId/excluir    ArtistaExcluirR   POST

-- Generos: listar, cadastrar, editar e excluir
/generos                        GenerosR          GET
/generos/novo                   GeneroNovoR       GET POST
/generos/#GeneroId/editar       GeneroEditarR     GET POST
/generos/#GeneroId/excluir      GeneroExcluirR    POST

-- Albuns: listar, cadastrar, ver detalhes (com faixas), editar e excluir
/albuns                         AlbunsR           GET
/albuns/novo                    AlbumNovoR        GET POST
!/albuns/#AlbumId               AlbumR            GET
/albuns/#AlbumId/editar         AlbumEditarR      GET POST
/albuns/#AlbumId/excluir        AlbumExcluirR     POST

-- Integracao com o MusicBrainz: buscar e importar um album
/albuns/buscar                  BuscaMusicBrainzR GET
!/albuns/importar/#Text         ImportarR         GET POST

-- Faixas: o cadastro fica na pagina do album
/albuns/#AlbumId/faixas         FaixaNovaR        POST
/faixas/#FaixaId/editar         FaixaEditarR      GET POST
/faixas/#FaixaId/excluir        FaixaExcluirR     POST

-- Fornecedores: listar, cadastrar, editar e excluir
/fornecedores                       FornecedoresR      GET
/fornecedores/novo                  FornecedorNovoR    GET POST
/fornecedores/#FornecedorId/editar  FornecedorEditarR  GET POST
/fornecedores/#FornecedorId/excluir FornecedorExcluirR POST

-- Estoque: situacao atual, historico e entrada de mercadoria
/estoque                        EstoqueR          GET
/estoque/entrada                EntradaEstoqueR   GET POST

-- Clientes: listar, cadastrar, editar e excluir
/clientes                       ClientesR         GET
/clientes/novo                  ClienteNovoR      GET POST
/clientes/#ClienteId/editar     ClienteEditarR    GET POST
/clientes/#ClienteId/excluir    ClienteExcluirR   POST

-- Vendas: listar, registrar, ver detalhes e cancelar
/vendas                         VendasR           GET
/vendas/nova                    VendaNovaR        GET POST
!/vendas/#VendaId               VendaR            GET
/vendas/#VendaId/cancelar       VendaCancelarR    POST

-- Arquivos estaticos (imagens)
/static                         StaticR           Static getStatic
